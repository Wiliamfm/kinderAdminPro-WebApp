# PocketBase backend URL (optional, defaults to http://127.0.0.1:8090)
PB_URL=http://127.0.0.1:8090

# SMTP configuration (only required for email features)
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=your-app-name <your-email@example.com>

# Base admin credentials (initial admin setup)
BASE_ADMIN_EMAIL=admin@example.com
BASE_ADMIN_PASSWORD=change-me-to-a-secure-password
